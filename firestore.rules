rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== HELPER FUNCTIONS (KEEP YOURS) =====
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== 🔐 USERS COLLECTION + SUBCOLLECTIONS =====
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
      
      // 🔥 NEW: Following subcollection - COMPLETE ISOLATION
      match /following/{targetUserId} {
        allow read, write: if isOwner(userId);
      }
      
      // 🔥 NEW: Wishlist subcollection - COMPLETE ISOLATION  
      match /wishlist/{productId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===== BUSINESS PROFILES (KEEP YOURS) =====
    match /business_profiles/{profileId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == profileId;
      allow update: if isSignedIn() && (isOwner(profileId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ===== PRODUCTS (KEEP YOURS - PUBLIC READ IS FINE) =====
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());    }

    // ===== ORDERS (KEEP YOURS - GOOD ISOLATION) =====
    match /orders/{orderId} {
      allow read: if isSignedIn() && 
        (resource.data.buyerId == request.auth.uid || 
         resource.data.sellerId == request.auth.uid || 
         isAdmin());
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ===== CUSTOMERS (KEEP YOURS) =====
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ===== COIN TRANSACTIONS (KEEP YOURS) =====
    match /coin_transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===== REFERRAL BONUSES (KEEP YOURS) =====
    match /referral_bonuses/{bonusId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ===== SUPPORT MESSAGES (KEEP YOURS) =====
    match /support_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===== 🔥 FIXED: WISHLIST ISOLATION (TOP-LEVEL FALLBACK) =====
    // If you're NOT using /users/{userId}/wishlist subcollection yet,
    // this ensures users can ONLY access their own wishlist items
    match /wishlist/{itemId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Optional: Block if you migrate to subcollection
      // allow read, write: if false;
    }
    // ===== 🔥 FIXED: CART ISOLATION - NEW STRUCTURE (RECOMMENDED) =====
    // NEW: /carts/{userId}/items/{productId} = COMPLETE ISOLATION
    match /carts/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }
    
    // OPTIONAL: Keep old cart structure but ADD userId validation as backup
    match /cart/{cartId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // After migration, uncomment below to disable old structure:
      // allow read, write: if false;
    }

    // ===== 🔥 NEW: NOTIFICATIONS COLLECTION (FOR FOLLOW/ORDER ALERTS) =====
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn(); // Anyone can send notifications to others
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ===== REFERRALS (KEEP YOURS) =====
    match /referrals/{referralId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
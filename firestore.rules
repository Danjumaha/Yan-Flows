rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== HELPER FUNCTIONS =====
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== 🔐 USERS COLLECTION =====
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // FIX: Allow updates if the logged-in user owns the account, is an admin,
      // OR if it's a buyer deducting exactly 1 coin from a seller's balance for an order processing fee.
      allow update: if isSignedIn() && (
        isOwner(userId) || 
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins']) &&
          request.resource.data.coins == resource.data.coins - 1
        )
      );
      allow delete: if isAdmin();
      
      match /following/{targetUserId} { allow read, write: if isOwner(userId); }
      match /wishlist/{productId} { allow read, write: if isOwner(userId); }
    }

    // ===== BUSINESS PROFILES =====
    match /business_profiles/{profileId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == profileId;
      allow update: if isSignedIn() && (isOwner(profileId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ===== PRODUCTS =====
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());    
    }

    // ===== ORDERS =====
    match /orders/{orderId} {
      allow read: if isSignedIn() && 
        (resource.data.buyerId == request.auth.uid || 
         resource.data.sellerId == request.auth.uid || 
         isAdmin());
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ===== TRANSACTIONS =====
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /coin_transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /customers/{customerId} { allow read, write: if isSignedIn(); }
    match /referral_bonuses/{bonusId} { allow read, write: if isSignedIn(); }
    match /support_messages/{messageId} { allow read, write: if isSignedIn(); allow update, delete: if isAdmin(); }
    
    // ===== CART ISOLATION =====
    match /carts/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }
    
    match /cart/{cartId} {
      allow read, write: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn(); 
    }

    match /referrals/{referralId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidRole(role) {
      return role in ['buyer', 'seller', 'admin'];
    }

    function isNonNegative(value) {
      return value is int && value >= 0;
    }

    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      
      allow create: if isSignedIn() && isOwner(userId) 
                    && isValidRole(request.resource.data.role)
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.referralCode is string
                    && request.resource.data.referralCode.size() > 4;
      
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin())
                    && roleUnchanged()
                    && (!request.resource.data.keys().hasAny(['coins']) || isNonNegative(request.resource.data.coins));
      
      allow delete: if isAdmin();
    }

    match /business_profiles/{userId} {
      allow read: if true;
      
      allow create, update: if isSignedIn() && (isOwner(userId) || isAdmin())
                            && request.resource.data.companyName is string                            && request.resource.data.companyName.size() > 0
                            && request.resource.data.whatsappNumber is string
                            && request.resource.data.whatsappNumber.size() > 8;
                            
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      
      allow create: if isSignedIn() 
                    && request.resource.data.sellerId == request.auth.uid
                    && isNonNegative(request.resource.data.price)
                    && isNonNegative(request.resource.data.stock)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
                    
      allow update, delete: if isSignedIn() 
                            && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && 
                  (resource.data.sellerId == request.auth.uid || 
                   resource.data.buyerId == request.auth.uid || 
                   isAdmin());
                  
      allow create: if isSignedIn() 
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.customer.name is string
                    && request.resource.data.customer.phone is string
                    && request.resource.data.totals.grandTotal is number
                    && request.resource.data.totals.grandTotal > 0;
                    
      allow update: if isSignedIn() && 
                    (resource.data.sellerId == request.auth.uid || isAdmin())
                    && request.resource.data.status in [
                      'pending', 'confirmed', 'processing', 
                      'out_for_delivery', 'delivered', 'cancelled'
                    ];
                    
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isSignedIn() && 
                         (resource != null && resource.data.sellerId == request.auth.uid ||
                          request.resource != null && request.resource.data.sellerId == request.auth.uid ||                          isAdmin());
    }

    match /coin_transactions/{transactionId} {
      allow read: if isSignedIn() && 
                  (resource.data.userId == request.auth.uid || isAdmin());
                  
      allow create: if isSignedIn() && isAdmin()
                    && request.resource.data.userId is string
                    && request.resource.data.coins is int
                    && request.resource.data.type in ['purchase', 'deduction', 'bonus', 'refund'];
                    
      allow update, delete: if isAdmin();
    }

    match /referral_bonuses/{bonusId} {
      allow read: if isSignedIn() && 
                  (resource.data.referrerId == request.auth.uid || isAdmin());
                  
      allow create, update, delete: if isAdmin();
    }

    match /support_messages/{messageId} {
      allow read: if isSignedIn() && isAdmin();
      
      allow create: if isSignedIn() 
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 10;
                    
      allow update, delete: if isAdmin();
    }
  }
}